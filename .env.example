# Copy this file to .env.deepseek.local for local DeepSeek configuration.
# The local file is ignored by Git. Do not commit a real key.
# Parent-process environment variables override this file; this file overrides .env.
DEEPSEEK_API_KEY=replace_with_your_own_key
DEEPSEEK_MODEL=deepseek-flash
# Optional: an OpenAI-compatible vision model used only when images are attached.
# Leave empty to send images to DEEPSEEK_MODEL. If the model rejects images, the API returns vision_unsupported.
DEEPSEEK_VISION_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=60000
PORT=5178
# Optional keyless exchange-rate endpoints (only currency codes are sent).
FX_BASE_URL=https://open.er-api.com/v6/latest
FX_FALLBACK_URL=https://api.frankfurter.app/latest
FX_TIMEOUT_MS=10000
FX_CACHE_TTL_MS=3600000

# Optional, opt-in Amazon public-front-end research. No login, seller backend, CAPTCHA bypass, or proxy is used.
# Leave false to run only from the local Intel page button.
AMAZON_RESEARCH_ON_START=false
AMAZON_RESEARCH_SCOPE=catalog
# Optional comma/newline-separated overrides. Catalog scope derives one query per category when empty.
AMAZON_RESEARCH_QUERIES=
AMAZON_RESEARCH_ASINS=
AMAZON_RESEARCH_MAX_PRODUCT_PAGES=12
AMAZON_RESEARCH_DELAY_MS=1200
